     if (!akf_fw_get_region(fw_node, &phys, &iova, &size))
         return false;
 
+    printf("ANS1-P0: firmware phys=0x%lx iova=0x%lx size=0x%lx\n", phys, iova, size);
     write32(akf->cpu_base + AKF_REMAP_IOVA_LO, iova & 0xffffffff);
