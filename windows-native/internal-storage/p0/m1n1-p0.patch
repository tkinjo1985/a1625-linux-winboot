+    if (akf && akf->cpu_base == 0x208040000)
+        return;
+#endif
     free(akf);
 }
 
@@ -141,6 +228,15 @@ int akf_get_iop_node(akf_dev_t *akf)
 
 bool akf_can_recv(akf_dev_t *akf)
 {
+#ifdef ANS1_P0
+    if (akf->cpu_base == 0x208040000) {
+        if (akf->p0_failed || akf->p0_stops || akf->p0_recv_checks >= 0x1000000) {
+            akf->p0_failed = true;
+            return false;
+        }
+        akf->p0_recv_checks++;
+    }
+#endif
     return !(read32(akf->base + AKF_MBOX_I2A_CONTROL) & AKF_MBOX_CONTROL_EMPTY);
 }
 
@@ -151,7 +247,18 @@ bool akf_can_send(akf_dev_t *akf)
 
 bool akf_send(akf_dev_t *akf, u64 msg)
 {
+#ifdef ANS1_P0
+    if (akf->cpu_base == 0x208040000) {
+        if (!akf->p0_started || akf->p0_failed || akf->p0_stops || akf->p0_sends >= 128)
+            return false;
+        akf->p0_sends++;
+    }
+#endif
     if (poll32(akf->base + AKF_MBOX_A2I_CONTROL, AKF_MBOX_CONTROL_FULL, 0, 200000)) {
+#ifdef ANS1_P0
+        if (akf->cpu_base == 0x208040000)
+            akf->p0_failed = true;
+#endif
         printf("akf: A2I mailbox full for 200ms. Is the akf stuck?");
         return false;
     }
