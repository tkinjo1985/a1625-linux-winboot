+        return false;
+#endif
 
+    printf("ANS1-P0: firmware phys=0x%lx iova=0x%lx size=0x%lx\n", phys, iova, size);
     write32(akf->cpu_base + AKF_REMAP_IOVA_LO, iova & 0xffffffff);
     write32(akf->cpu_base + AKF_REMAP_IOVA_HI, iova >> 32);
     write32(akf->cpu_base + AKF_REMAP_PHYS_LO, phys & 0xffffffff);
@@ -109,19 +165,46 @@ bool akf_map_preloaded_fw(akf_dev_t *akf)
     write32(akf->cpu_base + AKF_REMAP_SIZE_HI, size >> 32);
     /* 0 = BE, 1 = LE */
     write32(akf->cpu_base + AKF_ENDIANNESS, 1);
+#ifndef ANS1_P0
     write32(akf->cpu_base + AKF_UNK_80C, 0);
+#endif
 
+    akf->p0_mapped = true;
     return true;
 }
 
 void akf_cpu_start(akf_dev_t *akf)
 {
+#ifdef ANS1_P0
+    if (akf->cpu_base == 0x208040000) {
+        if (!akf->p0_mapped || akf->p0_started || akf->p0_stops)
+            return;
+        akf->p0_started = true;
+    }
+#endif
+    u32 before = read32(akf->cpu_base + AKF_CPU_CONTROL);
     set32(akf->cpu_base + AKF_CPU_CONTROL, AKF_CPU_CONTROL_START);
+    u32 after = read32(akf->cpu_base + AKF_CPU_CONTROL);
+    printf("ANS1-P0: CPU start before=0x%x after=0x%x\n", before, after);
+#ifdef ANS1_P0
+    if (akf->cpu_base == 0x208040000 && !(after & AKF_CPU_CONTROL_START))
+        akf->p0_failed = true;
+#endif
 }
 
 void akf_cpu_stop(akf_dev_t *akf)
 {
+#ifdef ANS1_P0
+    if (akf->cpu_base == 0x208040000) {
+        if (akf->p0_stops >= 2)
+            return;
+        akf->p0_stops++;
+    }
+#endif
+    u32 before = read32(akf->cpu_base + AKF_CPU_CONTROL);
     clear32(akf->cpu_base + AKF_CPU_CONTROL, AKF_CPU_CONTROL_START);
+    u32 after = read32(akf->cpu_base + AKF_CPU_CONTROL);
+    printf("ANS1-P0: CPU stop before=0x%x after=0x%x\n", before, after);
 }
 
 bool akf_cpu_running(akf_dev_t *akf)
@@ -131,6 +214,10 @@ bool akf_cpu_running(akf_dev_t *akf)
 
 void akf_free(akf_dev_t *akf)
 {
