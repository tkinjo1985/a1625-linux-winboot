+int pmgr_p0_ans_power_enable(void)
+{
+    static bool attempted;
+    static const u32 ids[] = {0x16, 0x35};
+    static const uintptr_t addresses[] = {0x20e020318, 0x20e020118};
+    if (attempted || !pmgr_initialized)
+        return -1;
+    attempted = true;
+    int node = adt_path_offset(adt, "/arm-io/ans");
+    if (node < 0)
+        return -1;
+    u32 bytes = 0;
+    const u32 *gates = adt_getprop(adt, node, "clock-gates", &bytes);
+    if (!gates || bytes != sizeof(ids))
+        return -1;
+    /* Validate the whole plan before the first MMIO write. No recursion. */
+    for (unsigned int i = 0; i < 2; i++) {
+        const struct pmgr_device *device;
+        u16 parents[2];
+        if (gates[i] != ids[i] || pmgr_find_device(ids[i], &device) ||
+            (device->flags & PMGR_FLAG_VIRTUAL))
+            return -1;
+        pmgr_adt_get_parents(device, parents);
+        if (parents[0] || parents[1] || pmgr_device_get_addr(0, device) != addresses[i])
+            return -1;
+    }
+    for (unsigned int i = 0; i < 2; i++) {
+        printf("ANS1-P0: PMGR id=0x%x addr=0x%lx target=0xf attempt=1\n", ids[i], addresses[i]);
+        if (pmgr_set_mode(addresses[i], PMGR_PS_ACTIVE))
+            return -1;
+    }
+    return 0;
+}
+
 int pmgr_adt_power_disable(const char *path)
 {
     return pmgr_adt_devices_set_mode(path, PMGR_PS_PWRGATE, false);
