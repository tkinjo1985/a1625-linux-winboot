+            return false;
+        akf->p0_map_attempted = true;
+        if (read32(akf->cpu_base + AKF_CPU_CONTROL) & AKF_CPU_CONTROL_START)
+            return false;
+    }
+#endif
     int fw_node = adt_first_child_offset(adt, akf->iop_node);
-    if (!fw_node) {
