+    bool p0_map_attempted, p0_mapped, p0_started, p0_failed;
+    unsigned int p0_stops, p0_sends, p0_recv_checks;
 };
+static u64 p0_fw_phys, p0_fw_iova, p0_fw_size;
+static bool p0_fw_reserved;
+
+bool akf_p0_reserve_firmware(void)
+{
+    int node = adt_path_offset(adt, "/arm-io/ans");
+    if (p0_fw_reserved || node < 0 || !akf_p0_validate_ans())
+        return false;
+    int fw_node = adt_first_child_offset(adt, node);
+    if (fw_node <= 0 || !akf_fw_get_region(fw_node, &p0_fw_phys, &p0_fw_iova, &p0_fw_size) ||
+        !heapblock_p0_reserve_firmware(p0_fw_phys, p0_fw_size))
+        return false;
+    p0_fw_reserved = true;
+    return true;
+}
+
+bool akf_p0_validate_ans(void)
+{
+    /* J42d RAM ADT inventory; this validates metadata without touching MMIO. */
+    static const u64 expected_base[] = {0x208040000, 0x208060000, 0x20e020000, 0x200f00000};
+    static const u64 expected_size[] = {0x2000, 0x1000, 0x1000, 0x100000};
+    int trace[8];
+    int node = adt_path_offset_trace(adt, "/arm-io/ans", trace);
+    if (node < 0 || !adt_is_compatible(adt, node, "iop,s5l8960x"))
+        return false;
+    for (unsigned int i = 0; i < 4; i++) {
+        u64 base, size;
+        if (adt_get_reg(adt, trace, "reg", i, &base, &size) < 0 ||
+            base != expected_base[i] || size != expected_size[i])
+            return false;
+    }
+    return true;
+}
 
 akf_dev_t *akf_init(const char *path)
 {
+#ifdef ANS1_P0
+    if (!strcmp(path, "/arm-io/ans") && !akf_p0_validate_ans())
+        return NULL;
+#endif
