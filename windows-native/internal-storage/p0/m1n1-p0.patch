new file mode 100644
index 0000000..05858e8
--- /dev/null
+++ b/src/rtkit_p0.h
@@ -0,0 +1,147 @@
+/* P0 outbound protocol policy. Storage opcodes are checked separately in ans1.c. */
+#ifndef RTKIT_P0_H
+#define RTKIT_P0_H
+
+#define P0_TYPE(t) ((u64)(t) << 52)
+struct rtkit_p0_policy {
+    u64 cmd, last[256];
+    u32 advertised[8];
+    bool pending[256], started[256], buffer_sent[256], map_seen[8];
+    bool init, hello, map_done, ap_on, quiesce, sleep, ready, cmd_ready;
+    bool cmd_sent, tag_sent, inflight;
+    u8 app_ep, version, rings;
+};
+
+static inline void rtkit_p0_observe(struct rtkit_p0_policy *p, u8 ep, u64 msg)
+{
+    p->last[ep] = msg;
+    p->pending[ep] = true;
+    if (ep == p->app_ep && p->app_ep && p->started[ep]) {
+        if (msg == 0xafe2)
+            p->ready = true;
+        if (msg == 0xafd2 && p->cmd_sent)
+            p->cmd_ready = true;
+        if (msg == 2 && p->inflight)
+            p->inflight = false;
+    }
+}
+
+/* own_addr/own_size describe the retained RTKit allocation for this endpoint. */
+static inline bool rtkit_p0_tx(struct rtkit_p0_policy *p, u8 ep, u64 msg,
+                               u64 own_addr, u64 own_size)
+{
+    if (!p->cmd || msg >> 56)
+        return false;
+    u64 incoming = p->last[ep];
+    if (!ep) {
+        if (msg == (P0_TYPE(6) | 0x220) && !p->init) {
+            p->init = true;
+            return true;
+        }
+        if (p->init && !p->hello && p->pending[0] && incoming >> 52 == 1) {
+            u32 lo = incoming & 0xffff, hi = (incoming >> 16) & 0xffff;
+            u32 version = hi < 12 ? hi : 12;
+            if (version >= 10 && lo <= version &&
+                msg == (P0_TYPE(2) | ((u64)version << 16) | version)) {
+                p->version = version;
+                p->hello = true;
+                p->pending[0] = false;
+                return true;
+            }
+        }
+        if (!p->hello)
+            return false;
+        if (p->pending[0] && incoming >> 52 == 8 && !p->map_done) {
+            u32 base = (incoming >> 32) & 7;
+            bool done = (incoming & ((u64)1 << 51)) || p->version == 10;
+            u64 expected = P0_TYPE(8) | ((u64)base << 32);
+            if (p->version > 10)
+                expected |= done ? ((u64)1 << 51) : 1;
+            if (!p->map_seen[base] && msg == expected) {
+                p->advertised[base] = (u32)incoming;
+                p->map_seen[base] = true;
+                p->map_done = done;
+                p->pending[0] = false;
+                return true;
+            }
+        }
+        if (msg >> 52 == 5 && !p->quiesce) {
+            u32 target = (msg >> 32) & 0xff;
+            bool system = target >= 1 && target <= 4;
+            system |= target == 8 && p->version > 10;
+            u32 chosen = p->version > 10 ? 32 :
+                         (p->advertised[0] & (1U << 6)) ? 6 : 5;
+            if (msg == (P0_TYPE(5) | ((u64)target << 32) | 2) &&
+                (system || target == chosen) && !p->started[target] &&
+                (p->advertised[target / 32] & (1U << (target % 32)))) {
+                if (!system) {
+                    if (p->app_ep)
+                        return false;
+                    p->app_ep = target;
+                }
+                p->started[target] = true;
+                return true;
+            }
+        }
+        if (msg == (P0_TYPE(0xb) | 0x20) && p->map_done && !p->ap_on && !p->quiesce &&
+            p->pending[0] && incoming == (P0_TYPE(7) | 0x20)) {
+            p->ap_on = true;
+            return true;
+        }
+        if (msg == (P0_TYPE(0xb) | 0x10) && !p->quiesce) {
+            p->quiesce = true;
+            return true;
+        }
+        if (msg == (P0_TYPE(6) | 1) && p->quiesce && !p->sleep &&
+            p->pending[0] && (incoming == (P0_TYPE(0xb) | 0x10) ||
+                             (p->version == 10 && incoming == P0_TYPE(0xb)))) {
+            p->sleep = true;
+            p->pending[0] = false;
+            return true;
+        }
+        return false;
+    }
+    if (!p->started[ep])
+        return false;
+    if (ep == p->app_ep) {
+        if (p->quiesce)
+            return false;
+        if (p->ap_on && !p->cmd_sent && p->ready && msg == ((p->cmd << 16) | 0x20)) {
+            p->cmd_sent = true;
+            return true;
+        }
+        if (p->cmd_ready && !p->tag_sent && msg == 0x2000001) {
+            p->tag_sent = true;
+            return true;
+        }
+        if (p->tag_sent && msg == 0xff003 && p->rings < 5 && !p->inflight) {
+            p->rings++;
+            p->inflight = true;
+            return true;
+        }
+        return false;
+    }
+    if (!p->pending[ep])
+        return false;
+    if ((ep == 1 || ep == 2 || ep == 4) && incoming >> 52 == 1 &&
+        !p->buffer_sent[ep] && !(incoming & (((u64)1 << 42) - 1))) {
+        u64 pages = (incoming >> 44) & 0xff;
+        if (pages && own_addr && !(own_addr & 0x3fff) && !(own_addr >> 42) &&
+            own_size == ((pages * 4096 + 16383) & ~(u64)16383) &&
+            msg == (P0_TYPE(1) | (pages << 44) | own_addr)) {
+            p->buffer_sent[ep] = true;
+            p->pending[ep] = false;
+            return true;
+        }
+    }
+    /* Replies echo only a recognized incoming notification, once per RX. */
+    if (msg == incoming &&
+        ((ep == 2 && incoming >> 52 == 5 && !(incoming & ~(P0_TYPE(15) | 0xff)) &&
+          p->buffer_sent[ep]) ||
+         (ep == 4 && (incoming == P0_TYPE(8) || incoming == P0_TYPE(0xc)) && p->buffer_sent[ep]))) {
+        p->pending[ep] = false;
+        return true;
+    }
+    return false;
+}
+#endif
