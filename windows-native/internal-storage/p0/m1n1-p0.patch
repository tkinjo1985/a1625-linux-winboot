     int node = adt_path_offset_trace(adt, path, akf_path);
     if (node < 0) {
@@ -71,6 +111,7 @@ akf_dev_t *akf_init(const char *path)
         akf->base = base + AKF_V2_OFF;
     } else {
         printf("akf: Unsupported compatible\n");
+        free(akf);
         return NULL;
     }
 
