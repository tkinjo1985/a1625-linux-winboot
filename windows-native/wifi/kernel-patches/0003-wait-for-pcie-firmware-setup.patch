diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/pcie.c b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/pcie.c
index 55f4d7b97..62bce25da 100644
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/pcie.c
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/pcie.c
@@ -6,6 +6,7 @@
 #include <linux/kernel.h>
 #include <linux/module.h>
 #include <linux/firmware.h>
+#include <linux/completion.h>
 #include <linux/pci.h>
 #include <linux/vmalloc.h>
 #include <linux/delay.h>
@@ -327,6 +328,7 @@ struct brcmf_otp_params {
 };
 
 struct brcmf_pciedev_info {
+	struct completion fw_setup_done;
 	enum brcmf_pcie_state state;
 	bool in_irq;
 	struct pci_dev *pdev;
@@ -2225,12 +2227,17 @@ static void brcmf_pcie_setup(struct device *dev, int ret,
 
 	brcmf_pcie_fwcon_timer(devinfo, true);
 
+	complete_all(&devinfo->fw_setup_done);
 	return;
 
 fail:
 	brcmf_err(bus, "Dongle setup failed\n");
 	brcmf_pcie_bus_console_read(devinfo, true);
 	brcmf_fw_crashed(dev);
+	/* remove() may be waiting while holding the device lock. Signal before
+	 * device_release_driver(), and do not access devinfo after this point.
+	 */
+	complete_all(&devinfo->fw_setup_done);
 	device_release_driver(dev);
 }
 
@@ -2464,6 +2471,7 @@ brcmf_pcie_probe(struct pci_dev *pdev, const struct pci_device_id *id)
 	if (devinfo == NULL)
 		return ret;
 
+	init_completion(&devinfo->fw_setup_done);
 	devinfo->pdev = pdev;
 	pcie_bus_dev = NULL;
 	devinfo->ci = brcmf_chip_attach(devinfo, pdev->device,
@@ -2592,6 +2600,10 @@ brcmf_pcie_remove(struct pci_dev *pdev)
 		return;
 
 	devinfo = bus->bus_priv.pcie->devinfo;
+	/* Firmware setup runs on the firmware loader's workqueue, outside the
+	 * PCI probe lifetime. Keep its state alive until the callback finishes.
+	 */
+	wait_for_completion(&devinfo->fw_setup_done);
 	brcmf_pcie_bus_console_read(devinfo, false);
 	brcmf_pcie_fwcon_timer(devinfo, false);
 
